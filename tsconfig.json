{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["extension/**/*.js", "extension/**/*.d.ts", "tools/**/*.mjs"],
  "exclude": ["node_modules", "tests"]
}
